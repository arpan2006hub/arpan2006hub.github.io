---
// src/components/Nav.astro
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300"
>
  <div class="container-site flex items-center justify-between py-4 sm:py-5">
    <!-- Logo / mark -->
    <a
      href="#hero"
      class="group flex items-center gap-2 font-semibold tracking-tight"
      aria-label="Arpan Barik — back to top"
    >
      <span class="text-accent text-lg font-bold">AB</span>
      <span class="text-muted font-normal text-sm group-hover:text-[var(--text)] transition-colors duration-200">
        / arpan barik
      </span>
    </a>

    <!-- Desktop nav links -->
    <nav aria-label="Primary navigation">
      <ul class="hidden md:flex items-center gap-8 list-none text-sm">
        {[
          ['About', '#about'],
          ['Skills', '#skills'],
          ['Projects', '#projects'],
          ['Hackathons', '#hackathons'],
          ['Contact', '#contact'],
        ].map(([label, href]) => (
          <li>
            <a
              href={href}
              class="text-muted transition-colors duration-200 hover:text-accent font-medium"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Theme toggle -->
    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        onclick="toggleTheme()"
        aria-label="Switch to light mode"
        aria-pressed="true"
        class="flex items-center justify-center w-9 h-9 rounded-md border border-[var(--border)] text-muted hover:text-accent hover:border-[var(--accent)] transition-all duration-200 cursor-pointer bg-[var(--surface)]"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          id="icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          id="icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="hidden"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav (fixed bottom bar) -->
<nav
  class="md:hidden fixed bottom-0 left-0 right-0 z-50 border-t border-[var(--border)]"
  style="background-color: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(16px);"
  aria-label="Mobile navigation"
>
  <ul class="flex justify-around list-none py-3 px-2">
    {[
      ['About', '#about'],
      ['Skills', '#skills'],
      ['Projects', '#projects'],
      ['Hackathons', '#hackathons'],
      ['Contact', '#contact'],
    ].map(([label, href]) => (
      <li>
        <a
          href={href}
          class="text-muted text-xs font-medium transition-colors duration-200 hover:text-accent px-2 py-1"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Scroll-shadow for nav
  const nav = document.getElementById('site-nav');
  if (nav) {
    const onScroll = () => {
      if (window.scrollY > 20) {
        nav.classList.add('nav-scrolled');
      } else {
        nav.classList.remove('nav-scrolled');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Sync theme toggle icon on page load
  (function syncIcon() {
    const isLight = document.documentElement.classList.contains('light');
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    const btn = document.getElementById('theme-toggle');
    if (sun) sun.classList.toggle('hidden', isLight);
    if (moon) moon.classList.toggle('hidden', !isLight);
    if (btn) {
      btn.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
      btn.setAttribute('aria-pressed', isLight ? 'false' : 'true');
    }
  })();
</script>
