---
// src/components/Contact.astro
import { contact } from '../content/profile';

const year = new Date().getFullYear();
---

<section id="contact" class="section-pad section-divider bg-[var(--surface)]">
  <div class="container-site" data-reveal>
    
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start mb-16">
      
      <!-- Left Column: Heading & Note (5 cols) -->
      <div class="lg:col-span-5 flex flex-col">
        <span class="section-label">Contact</span>
        <h2 class="t-h2 text-[var(--text)] mb-4">
          Let's build something credible.
        </h2>
        <p class="t-body text-[var(--text-muted)] mb-6">
          Always open to collaborating.
        </p>
        <div class="p-4 rounded-md border border-[var(--border)] bg-[var(--bg)]">
          <p class="mono text-xs text-[var(--text-muted)] flex items-center gap-2">
            <span class="status-dot"></span>
            <span>Response time: within 24 hours</span>
          </p>
        </div>
      </div>

      <!-- Right Column: Interactive Link Cards (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        {contact.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('mailto') ? undefined : '_blank'}
            rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
            class="group p-5 rounded-md border border-[var(--border)] bg-[var(--bg)] hover:border-[var(--accent)] hover:bg-[var(--surface-hover)] transition-all duration-200 flex items-center justify-between"
            aria-label={`${link.label}: ${link.display}`}
          >
            <div class="flex items-center gap-4">
              <span class="mono text-xs font-semibold uppercase tracking-wider text-accent px-2.5 py-1 rounded bg-[var(--accent-muted)]">
                {link.label}
              </span>
              <span class="mono text-sm sm:text-base text-[var(--text)] group-hover:text-accent transition-colors font-medium">
                {link.display}
              </span>
            </div>
            <span class="text-muted group-hover:text-accent group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-200 font-mono text-sm" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>

    </div>

    <!-- Footer -->
    <div class="mt-12 pt-8 border-t border-[var(--border)] flex flex-col items-center justify-center text-center text-xs mono text-muted gap-3">
      <a href="/ArpanBarik_resume.pdf" download="ArpanBarik_resume.pdf" class="text-muted hover:text-accent transition-colors underline underline-offset-2">
        Download Resume
      </a>
      <p>
        © {year} Arpan Barik. All rights reserved.
      </p>
    </div>

  </div>
</section>
