---
// src/components/Hero.astro
import { hero, contact, about, skills, projects } from '../content/profile';
---

<section
  id="hero"
  class="section-pad min-h-[90vh] flex flex-col justify-center relative overflow-hidden"
  style="padding-top: calc(clamp(4.5rem, 8vw, 7.5rem) + 2rem);"
>
  <!-- Ethereum ASCII Art Background -->
  <div class="absolute inset-0 flex items-center justify-center z-0 pointer-events-none opacity-15">
    <pre class="font-mono text-sm leading-none whitespace-pre" style="color: #FC5A03; transform: scale(1.2); letter-spacing: -0.05em;">
                                         :=#                                         
                                        ..=##                                        
                                       ...=*#                                       
                                      ....=***#                                      
                                     .....=***##                                     
                                    ......=****##                                    
                                   .......=*****#*                                   
                                 :........=*******##                                 
                                ..........=*******###                                
                               ...........=*********##                               
                              ............=**********##                              
                             :............=************#                             
                            ..............=*************#                            
                           ...............=*************##                           
                          ................=**************##%                         
                         .................=***************##                         
                       ...................=#*****************#                       
                      ................::-+#%####************###                      
                     .............:-=+****#%%%%%%##***********##                     
                    ...........:=+********#%%%%%%%%%%##********##                    
                   ........:+*************#%%%%%%%%%%%%%%##*****##                   
                  ....::=*****************#%%%%%%%%%%%%%%%%%%###**#                  
                 .:-=*********************#%%%%%%%%%%%%%%%%%%%%%%####                
                =*************************#%%%%%%%%%%%%%%%%%%%%%%%%%%                
                  ************************#%%%%%%%%%%%%%%%%%%%%%%@@                  
                      ********************#%%%%%%%%%%%%%%%%%%%%                      
                :.:      *****************#%%%%%%%%%%%%%%%%@      #**                
                 .....      **************#%%%%%%%%%%%%%@      *****                 
                   ......      ***********#%%%%%%%%%%@      ******                   
                    ........      ********#%%%%%%%@      ********                    
                     :.........      #****#%%%%@      **********                     
                       :..........:     **#%@      ***********                       
                        ..............         **************                        
                         :..............     ***************                         
                           ...............=***************                           
                            :.............=**************                            
                             .............=*************                             
                               ...........=************                              
                                ..........=**********                                
                                 :........=*********                                 
                                   .......=*******                                   
                                    ......=******                                    
                                     .....=*****                                     
                                      :...=****                                      
                                        ..=**                                        
                                         .=*
    </pre>
  </div>

  <div class="container-site relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left / Main Column (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start">
        
        <!-- On-chain badge status -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full border border-[var(--border)] bg-[var(--surface)] mb-8 text-xs mono">
          <span class="status-dot"></span>
          <span class="text-muted">Hi, I am</span>
        </div>

        <!-- Name -->
        <h1 class="t-hero text-[var(--text)] mb-4">
          {hero.name}
        </h1>

        <!-- Title -->
        <p class="t-h3 text-[var(--text-muted)] mb-8 max-w-xl">
          {hero.title}
        </p>

        <!-- One-line framing -->
        <div class="p-5 sm:p-6 rounded-r-md border-l-2 border-[var(--accent)] bg-[var(--surface)] mb-12 max-w-xl">
          <p class="t-body text-[var(--text)] text-sm sm:text-base leading-relaxed">
            {hero.framing}
          </p>
        </div>

        <!-- CTA Section Group -->
        <div class="flex flex-col gap-8 w-full max-w-md">
          <!-- Action buttons -->
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full">
            <a
              href="#projects"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-[var(--accent)] text-[#0C0A08] font-mono text-sm font-semibold tracking-wide transition-all duration-200 hover:brightness-110 hover:shadow-lg shadow-black/30 cursor-pointer whitespace-nowrap"
            >
              <span>View Projects ↓</span>
            </a>
            <a
              href="#contact"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md border border-[var(--border)] bg-[var(--surface)] text-[var(--text)] font-mono text-sm font-medium hover:border-[var(--accent)] hover:text-accent transition-all duration-200 whitespace-nowrap"
            >
              <span>Get in touch</span>
            </a>
          </div>

          <!-- Social / Contact Icon Buttons -->
          <div class="flex items-center gap-4" role="list" aria-label="Social and Contact links">
          {/* Resume Download Button */}
          <a
            href="/ArpanBarik_resume.pdf"
            download="ArpanBarik_resume.pdf"
            class="w-12 h-12 rounded-md border border-[var(--border)] bg-[var(--surface)] text-[var(--text-muted)] hover:text-accent hover:border-[var(--accent)] hover:bg-[var(--surface-hover)] transition-all duration-200 flex items-center justify-center"
            aria-label="Download Resume"
            title="Download Resume"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </a>

          {contact.map((link) => (
            <a
              href={link.href}
              class="w-12 h-12 rounded-md border border-[var(--border)] bg-[var(--surface)] text-[var(--text-muted)] hover:text-accent hover:border-[var(--accent)] hover:bg-[var(--surface-hover)] transition-all duration-200 flex items-center justify-center"
              target={link.href.startsWith('mailto') ? undefined : '_blank'}
              rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
              aria-label={`${link.label}: ${link.display}`}
              title={`${link.label}: ${link.display}`}
            >
              {link.label === 'Email' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              )}
              {link.label === 'GitHub' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                  <path d="M9 18c-4.51 2-5-2-7-2"/>
                </svg>
              )}
              {link.label === 'X' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {link.label === 'LinkedIn' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
        </div>

      </div>

      <!-- Right Column: Technical Profile & On-Chain Snapshot (5 cols) -->
      <div class="lg:col-span-5 w-full">
        <div class="spec-card shadow-xl shadow-black/20">
          <div class="spec-card-header">
            <div class="flex items-center gap-2">
              <span class="status-dot"></span>
              <span class="text-accent font-semibold">DEV // PROFILE SPEC</span>
            </div>
          </div>

          <div class="spec-card-body">
            <div class="spec-row">
              <span class="text-muted">Specialization</span>
              <span class="text-[var(--text)] font-medium text-right">Blockchain Engineering</span>
            </div>
            <div class="spec-row">
              <span class="text-muted">Institution</span>
              <span class="text-[var(--text)] text-right">{about.education.institution} ('28)</span>
            </div>
            <div class="spec-row">
              <span class="text-muted">Core Languages</span>
              <span class="text-accent text-right">Solidity · Python · C++</span>
            </div>
            <div class="spec-row">
              <span class="text-muted">Web3 Stack</span>
              <span class="text-[var(--text)] text-right">Foundry · Hardhat · IPFS</span>
            </div>
            <div class="spec-row">
              <span class="text-muted">Target Network</span>
              <span class="text-[var(--text)] text-right">Ethereum (Sepolia)</span>
            </div>

            <!-- Quick Terminal info inside card -->
            <div class="mt-2 pt-3 border-t border-[var(--border)] flex items-center justify-between">
              <span class="text-muted text-[0.7rem]">CONSENSUS · ZK · CONTRACTS</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
