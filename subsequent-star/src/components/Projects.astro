---
// src/components/Projects.astro
import { projects } from '../content/profile';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="section-pad section-divider bg-[var(--surface)]">
  <div class="container-site" data-reveal>
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <span class="section-label">Projects</span>
      <h2 class="t-h2 text-[var(--text)]">
        Shipped decentralized systems
      </h2>
    </div>

    <!-- Featured + Grid layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      {projects.map((project, i) => (
        <div class="h-full">
          <ProjectCard project={project} featured={i === 0} />
        </div>
      ))}
    </div>

  </div>
</section>
