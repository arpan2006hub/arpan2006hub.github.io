---
// src/components/About.astro
import { about } from '../content/profile';
---

<section id="about" class="section-pad section-divider bg-[var(--surface)]">
  <div class="container-site" data-reveal>
    
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Editorial & Bio (7 cols) -->
      <div class="lg:col-span-7 flex flex-col">
        <span class="section-label">About</span>
        
        <h2 class="t-h2 text-[var(--text)] mb-6">
          Building at the intersection of crypto, code, and consequence.
        </h2>

        <div class="prose prose-invert">
          <p class="t-body text-[var(--text-muted)] leading-relaxed">
            {about.bio}
          </p>
        </div>
      </div>

      <!-- Right Column: Education & Coursework Card (5 cols) -->
      <div class="lg:col-span-5 w-full">
        <aside
          class="spec-card shadow-xl shadow-black/20"
          aria-label="Education Details"
        >
          <div class="spec-card-header">
            <div class="flex items-center justify-between w-full">
              <div class="flex items-center gap-2">
                <span class="status-dot"></span>
                <span class="text-accent font-semibold">EDUCATION</span>
              </div>
              <span class="mono text-muted text-xs">
                {about.education.year}
              </span>
            </div>
          </div>

          <div class="spec-card-body">
            <div class="spec-row">
              <span class="text-muted">Degree</span>
              <span class="text-[var(--text)] font-medium text-right">{about.education.degree}</span>
            </div>
            <div class="spec-row">
              <span class="text-muted">Institution</span>
              <span class="text-[var(--text)] text-right">{about.education.institution}</span>
            </div>
            <div class="spec-row">
              <span class="text-muted">Location</span>
              <span class="text-[var(--text)] text-right">{about.education.location}</span>
            </div>
            <div class="spec-row">
              <span class="text-muted">Expected Graduation</span>
              <span class="text-accent text-right">{about.education.expectedGraduation}</span>
            </div>

            <!-- Coursework -->
            <div class="mt-2 pt-3 border-t border-[var(--border)]">
              <p class="mono text-muted text-[0.7rem] uppercase tracking-wider mb-3">
                Relevant Coursework
              </p>
              <ul class="grid grid-cols-1 gap-2 list-none" role="list">
                {about.education.coursework.map((course) => (
                  <li class="text-sm text-[var(--text-muted)] flex items-center gap-2">
                    <span class="text-accent font-bold">›</span>
                    <span>{course}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>

    </div>

  </div>
</section>
